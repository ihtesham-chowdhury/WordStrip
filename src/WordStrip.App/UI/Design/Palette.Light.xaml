<!-- The Settings window's light palette. Keys only: every style in Controls.xaml reads these through
     DynamicResource, so swapping this dictionary for Palette.Dark.xaml retints the whole window without a
     single style knowing which one is loaded. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Ws.Window" Color="#F4F5F7" />
    <SolidColorBrush x:Key="Ws.Rail" Color="#EDEFF2" />
    <SolidColorBrush x:Key="Ws.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ws.Card.Border" Color="#E3E5E9" />
    <SolidColorBrush x:Key="Ws.Divider" Color="#E3E5E9" />

    <!-- Text -->
    <SolidColorBrush x:Key="Ws.Text" Color="#1A1C20" />
    <SolidColorBrush x:Key="Ws.Text.Muted" Color="#5C626D" />
    <SolidColorBrush x:Key="Ws.Text.Disabled" Color="#9BA1AC" />

    <!-- Accent. One accent for the whole product: the Settings window and the bar's own indicator. -->
    <SolidColorBrush x:Key="Ws.Accent" Color="#5B5BD6" />
    <SolidColorBrush x:Key="Ws.Accent.Hover" Color="#5151C4" />
    <SolidColorBrush x:Key="Ws.Accent.Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ws.Accent.Soft" Color="#E8E8FA" />

    <!-- Controls -->
    <SolidColorBrush x:Key="Ws.Control" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ws.Control.Border" Color="#CDD1D8" />
    <SolidColorBrush x:Key="Ws.Control.Hover" Color="#F2F3F6" />
    <SolidColorBrush x:Key="Ws.Control.Pressed" Color="#E7E9EE" />
    <SolidColorBrush x:Key="Ws.Control.Disabled" Color="#F0F1F4" />
    <SolidColorBrush x:Key="Ws.Track" Color="#D7DAE0" />
    <SolidColorBrush x:Key="Ws.Toggle.Off" Color="#C6CAD2" />
    <SolidColorBrush x:Key="Ws.Toggle.Knob" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ws.Scroll.Thumb" Color="#C2C6CE" />

    <!-- States -->
    <SolidColorBrush x:Key="Ws.Focus" Color="#1A1C20" />
    <SolidColorBrush x:Key="Ws.Warning" Color="#8A5A00" />
    <SolidColorBrush x:Key="Ws.Warning.Bg" Color="#FFF4E5" />
    <SolidColorBrush x:Key="Ws.Info.Bg" Color="#EDF1F7" />
    <SolidColorBrush x:Key="Ws.Good" Color="#1F7A4D" />

</ResourceDictionary>
