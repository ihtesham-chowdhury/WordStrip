<!--
    The Settings window's controls, as one system.

    Every visual here is a full template rather than a tweak of the WPF default: the defaults carry Windows 7
    bevels, their own focus rectangles, their own disabled greys and their own corner radii, and no amount of
    setting properties makes a page of them look like one design. Colour comes from the palette dictionary
    through DynamicResource, so these styles work unchanged in light and dark.

    Sizes mirror WordStrip.App.UI.Design.DesignTokens. They are literals here because a resource dictionary
    cannot reach a static class's nested constants without being harder to read than the numbers themselves;
    the tokens file remains the place the numbers are decided.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <sys:Double x:Key="Ws.ControlHeight">32</sys:Double>
    <CornerRadius x:Key="Ws.ControlRadius">6</CornerRadius>
    <CornerRadius x:Key="Ws.CardRadius">10</CornerRadius>

    <!-- One focus ring everywhere: drawn outside the control, two device-independent units thick, in the
         palette's focus colour. Keyboard focus has to be visible on every surface, including the accent
         button, which is why it is an outline rather than a tint. -->
    <Style x:Key="Ws.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border CornerRadius="8" Margin="-3"
                            BorderThickness="2"
                            BorderBrush="{DynamicResource Ws.Focus}"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === Type ==================================================================================== -->

    <Style x:Key="Ws.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ws.Text}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="Ws.PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Ws.Text.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style x:Key="Ws.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ws.Text}" />
        <Setter Property="Margin" Value="2,0,0,8" />
    </Style>

    <Style x:Key="Ws.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource Ws.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Ws.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Ws.Text.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="Ws.Value" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ws.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- === Surfaces ================================================================================ -->

    <Style x:Key="Ws.CardPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ws.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ws.Card.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Ws.CardRadius}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="Ws.Notice" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ws.Warning.Bg}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="Ws.InfoPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ws.Info.Bg}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- === Buttons ================================================================================= -->

    <Style TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ws.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ws.Text}" />
        <Setter Property="Background" Value="{DynamicResource Ws.Control}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ws.Control.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="{StaticResource Ws.ControlHeight}" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Ws.ControlRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Ws.Control.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Ws.Control.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Ws.Control.Disabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource Ws.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ws.AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Ws.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Ws.Accent.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- === Toggle switch ===========================================================================
         A CheckBox, because that is what the view model binds to and what a screen reader announces,
         drawn as the switch Windows 11 uses for "this is on or off" rather than a tick in a box. -->
    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ws.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ws.Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" MinHeight="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <Border x:Name="Track" Grid.Column="1"
                                Width="40" Height="22" CornerRadius="11"
                                Background="{DynamicResource Ws.Toggle.Off}"
                                VerticalAlignment="Center">
                            <Border x:Name="Knob"
                                    Width="14" Height="14" CornerRadius="7"
                                    Background="{DynamicResource Ws.Toggle.Knob}"
                                    HorizontalAlignment="Left"
                                    Margin="4,0,0,0" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Ws.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="16" />
                            <Setter TargetName="Knob" Property="Height" Value="16" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Ws.Text.Disabled}" />
                            <Setter TargetName="Track" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === Segmented control =======================================================================
         For a handful of mutually exclusive values — light/dark, where the bar sits, how fast it moves.
         A RadioButton underneath, so keyboard and screen-reader behaviour are the platform's. -->
    <Style x:Key="Ws.SegmentGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ws.Control.Disabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ws.Control.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="Ws.Segment" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ws.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ws.Text.Muted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Surface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Ws.Control.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Ws.Card}" />
                            <Setter Property="Foreground" Value="{DynamicResource Ws.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Ws.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Radio buttons outside a segmented group still need a coherent look. -->
    <Style TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ws.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ws.Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent" MinHeight="24">
                        <Border x:Name="Ring" Width="18" Height="18" CornerRadius="9"
                                BorderThickness="1" BorderBrush="{DynamicResource Ws.Control.Border}"
                                Background="{DynamicResource Ws.Control}" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Ws.Accent.Text}" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Background" Value="{DynamicResource Ws.Accent}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Ws.Accent}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Ws.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === Slider ==================================================================================
         Kept for the genuinely continuous values (material thickness, bar size). Discrete choices use the
         segmented control instead, where a slider would imply a range that isn't there. -->
    <Style TargetType="Thumb" x:Key="Ws.SliderThumb">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse Fill="{DynamicResource Ws.Accent}" />
                        <Ellipse Fill="{DynamicResource Ws.Toggle.Knob}" Width="7" Height="7" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ws.FocusVisual}" />
        <!-- WPF sliders step by a page when the track is clicked, which reads as "clicking does nothing, I
             have to drag it". Move-to-point is what every other slider on the platform does. -->
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Ws.Track}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Ws.Accent}"
                                                    VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Ws.SliderThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === Text box ================================================================================ -->

    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Ws.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Ws.Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="MinHeight" Value="{StaticResource Ws.ControlHeight}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Surface"
                            Background="{DynamicResource Ws.Control}"
                            BorderBrush="{DynamicResource Ws.Control.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Ws.ControlRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Ws.Text.Muted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Ws.Accent}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Surface" Property="Padding" Value="9,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === Scrolling ===============================================================================
         A thin overlay-style scrollbar. The default one is a wide grey channel with stepper arrows, and it
         appears and disappears as content changes, which moves the layout underneath it. -->
    <Style x:Key="Ws.ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource Ws.Scroll.Thumb}" CornerRadius="3" Margin="2,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Ws.ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === Navigation rail ========================================================================= -->

    <Style x:Key="Ws.NavItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ws.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ws.Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Surface" Background="Transparent" CornerRadius="7" Padding="10,8" MinHeight="34">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Ws.Control.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Ws.Accent.Soft}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ws.NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Ws.NavItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- === Lists =================================================================================== -->

    <Style x:Key="Ws.ListItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ws.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ws.Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Surface" Background="Transparent" CornerRadius="6" Padding="10,6">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Ws.Control.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Ws.Accent.Soft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ws.List" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Ws.ListItem}" />
    </Style>

    <!-- A count, a size, anything with a few discrete values: the same segmented look, driven by selection
         rather than by a group of radio buttons, so it can bind straight to a number. -->
    <Style x:Key="Ws.SegmentedItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Ws.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Ws.Text.Muted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Surface" Background="Transparent" CornerRadius="6" Padding="16,6" MinWidth="30">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Ws.Control.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Ws.Card}" />
                            <Setter Property="Foreground" Value="{DynamicResource Ws.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ws.SegmentedList" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Ws.Control.Disabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ws.Control.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Ws.SegmentedItem}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- === Progress ================================================================================ -->

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource Ws.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Ws.Track}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border CornerRadius="2" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
