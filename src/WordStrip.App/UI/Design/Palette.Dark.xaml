<!-- The dark counterpart of Palette.Light.xaml, authored rather than derived by inversion — the same rule
     the bar's themes follow, and for the same reason: inverted colours come out muddy. Same keys, so the
     styles never need to know which palette is loaded. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Ws.Window" Color="#1C1E22" />
    <SolidColorBrush x:Key="Ws.Rail" Color="#17191C" />
    <SolidColorBrush x:Key="Ws.Card" Color="#25282D" />
    <SolidColorBrush x:Key="Ws.Card.Border" Color="#33373E" />
    <SolidColorBrush x:Key="Ws.Divider" Color="#33373E" />

    <!-- Text -->
    <SolidColorBrush x:Key="Ws.Text" Color="#ECEEF2" />
    <SolidColorBrush x:Key="Ws.Text.Muted" Color="#A2A8B4" />
    <SolidColorBrush x:Key="Ws.Text.Disabled" Color="#6A707B" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Ws.Accent" Color="#8A8AF0" />
    <SolidColorBrush x:Key="Ws.Accent.Hover" Color="#9A9AF5" />
    <SolidColorBrush x:Key="Ws.Accent.Text" Color="#14141F" />
    <SolidColorBrush x:Key="Ws.Accent.Soft" Color="#2E2F44" />

    <!-- Controls -->
    <SolidColorBrush x:Key="Ws.Control" Color="#2C3036" />
    <SolidColorBrush x:Key="Ws.Control.Border" Color="#454A53" />
    <SolidColorBrush x:Key="Ws.Control.Hover" Color="#343941" />
    <SolidColorBrush x:Key="Ws.Control.Pressed" Color="#3C424B" />
    <SolidColorBrush x:Key="Ws.Control.Disabled" Color="#26292E" />
    <SolidColorBrush x:Key="Ws.Track" Color="#464C56" />
    <SolidColorBrush x:Key="Ws.Toggle.Off" Color="#565D68" />
    <SolidColorBrush x:Key="Ws.Toggle.Knob" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ws.Scroll.Thumb" Color="#4C525C" />

    <!-- States -->
    <SolidColorBrush x:Key="Ws.Focus" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ws.Warning" Color="#F0C27A" />
    <SolidColorBrush x:Key="Ws.Warning.Bg" Color="#3A2E1C" />
    <SolidColorBrush x:Key="Ws.Info.Bg" Color="#242A33" />
    <SolidColorBrush x:Key="Ws.Good" Color="#5CC98F" />

</ResourceDictionary>
