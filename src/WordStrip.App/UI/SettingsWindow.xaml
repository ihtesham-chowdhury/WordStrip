<Window x:Class="WordStrip.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WordStrip"
        Width="960" Height="660"
        MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="{DynamicResource Ws.Window}"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <!-- Settings apply as they are changed, so there is no Apply and no Done: the window closes like any
         other window. The footer that used to be docked here overlaid the scrolled content on a short
         display, which is the usual fate of a bar pinned over a scroll area. -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The palette is swapped for the dark one in code when Windows is in dark mode; every
                     style reads it through DynamicResource, so nothing else changes. -->
                <ResourceDictionary Source="Design/Palette.Light.xaml" />
                <ResourceDictionary Source="Design/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- === Navigation rail ==================================================================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource Ws.Rail}"
                BorderBrush="{DynamicResource Ws.Divider}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,16">
                    <TextBlock Text="WordStrip" FontSize="16" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI"
                               Foreground="{DynamicResource Ws.Text}" />
                    <TextBlock Text="Settings apply as you change them" FontSize="11.5"
                               Foreground="{DynamicResource Ws.Text.Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>

                <ListBox x:Name="Nav" Style="{StaticResource Ws.NavList}" SelectedIndex="0"
                         SelectionChanged="OnSectionChanged"
                         AutomationProperties.Name="Settings sections">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBoxItem AutomationProperties.Name="Appearance">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                       Width="24" VerticalAlignment="Center" />
                            <TextBlock Text="Appearance" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem AutomationProperties.Name="Suggestions">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                       Width="24" VerticalAlignment="Center" />
                            <TextBlock Text="Suggestions" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem AutomationProperties.Name="Your words">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                       Width="24" VerticalAlignment="Center" />
                            <TextBlock Text="Your words" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem AutomationProperties.Name="Learning and privacy">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                       Width="24" VerticalAlignment="Center" />
                            <TextBlock Text="Learning &amp; privacy" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem AutomationProperties.Name="Context model">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                       Width="24" VerticalAlignment="Center" />
                            <TextBlock Text="Context model" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem AutomationProperties.Name="Integrations">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                       Width="24" VerticalAlignment="Center" />
                            <TextBlock Text="Integrations" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem AutomationProperties.Name="General">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                       Width="24" VerticalAlignment="Center" />
                            <TextBlock Text="General" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- === Pages ============================================================================== -->
        <Grid Grid.Column="1" x:Name="Pages">

            <!-- === Appearance ======================================================================
                 The preview stays at the top of this page because every control below it changes what the
                 preview shows; Phase F makes it sticky and adds the theme gallery. -->
            <ScrollViewer x:Name="PageAppearance" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,24,28,36" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Appearance" Style="{StaticResource Ws.PageTitle}" />
                    <TextBlock Style="{StaticResource Ws.PageSubtitle}"
                               Text="The bar floats over whatever you are typing in, so every theme is shown over a light page and a dark one." />

                    <Border CornerRadius="{StaticResource Ws.CardRadius}" Margin="0,0,0,20" ClipToBounds="True"
                            BorderThickness="1" BorderBrush="{DynamicResource Ws.Card.Border}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Background="#FFFFFF" Height="92">
                                <TextBlock Text="a light document, like Notepad or Word"
                                           Foreground="#C8CCD4" FontSize="15"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <ContentPresenter x:Name="PreviewLight" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="1" Background="#1C1D21" Height="92">
                                <TextBlock Text="a dark app, like an editor or IDE"
                                           Foreground="#4A4D55" FontSize="15"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <ContentPresenter x:Name="PreviewDark" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock Text="Theme" Style="{StaticResource Ws.SectionTitle}" />
                    <Border Style="{StaticResource Ws.CardPanel}">
                        <ListBox Style="{StaticResource Ws.List}"
                                 ItemsSource="{Binding Themes}"
                                 SelectedItem="{Binding SelectedTheme}"
                                 AutomationProperties.Name="Theme">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                                   Foreground="{DynamicResource Ws.Text}" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Ws.Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <TextBlock Text="Surface" Style="{StaticResource Ws.SectionTitle}" />
                    <Border Style="{StaticResource Ws.CardPanel}">
                        <StackPanel>
                            <TextBlock Text="Light or dark" Style="{StaticResource Ws.Label}" Margin="0,0,0,8" />
                            <Border Style="{StaticResource Ws.SegmentGroup}" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Ws.Segment}" GroupName="Appearance"
                                                 Content="Auto" IsChecked="{Binding AppearanceAuto}" />
                                    <RadioButton Style="{StaticResource Ws.Segment}" GroupName="Appearance"
                                                 Content="Light" IsChecked="{Binding AppearanceLight}" />
                                    <RadioButton Style="{StaticResource Ws.Segment}" GroupName="Appearance"
                                                 Content="Dark" IsChecked="{Binding AppearanceDark}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Ws.Caption}" Margin="0,0,0,18"
                                       Text="Auto matches whatever is behind the bar. Pick light or dark to stop it changing as you scroll or switch tabs." />

                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="{Binding GlassTintPercent}" Width="48" DockPanel.Dock="Right" Style="{StaticResource Ws.Value}" />
                                <TextBlock Text="Material thickness" Style="{StaticResource Ws.Label}" />
                            </DockPanel>
                            <Slider Minimum="{Binding MinGlassTint}" Maximum="{Binding MaxGlassTint}"
                                    Value="{Binding GlassTint}" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="Material thickness" />
                            <TextBlock Style="{StaticResource Ws.Caption}"
                                       Text="Thicker is easier to read; thinner shows more of what is behind it." />

                            <Border Style="{StaticResource Ws.Notice}" Margin="0,14,0,0"
                                    Visibility="{Binding TransparencyDisabledBySystem, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Ws.Caption}" Foreground="{DynamicResource Ws.Warning}"
                                           Text="Windows has transparency effects switched off, or a High Contrast theme is on, so the bar is drawn as a solid panel." />
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Shape and size" Style="{StaticResource Ws.SectionTitle}" />
                    <Border Style="{StaticResource Ws.CardPanel}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="{Binding BarScaleLabel}" Width="120" DockPanel.Dock="Right" Style="{StaticResource Ws.Value}" />
                                <TextBlock Text="Bar thickness" Style="{StaticResource Ws.Label}" />
                            </DockPanel>
                            <Slider Minimum="{Binding MinBarScale}" Maximum="{Binding MaxBarScale}"
                                    Value="{Binding BarScale}" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="Bar thickness" />
                            <TextBlock Style="{StaticResource Ws.Caption}" Margin="0,0,0,18"
                                       Text="A thinner bar gets in the way less, which matters most when it follows the cursor." />

                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding FixedBarWidth}"
                                          AutomationProperties.Name="Keep the bar one width" />
                                <TextBlock Text="Keep the bar one width" Style="{StaticResource Ws.Label}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Ws.Caption}"
                                       Text="Like a phone keyboard: the bar keeps one size while you type instead of resizing around the words." />

                            <StackPanel Margin="0,16,0,0"
                                        Visibility="{Binding FixedBarWidth, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="{Binding BarWidthLabel}" Width="120" DockPanel.Dock="Right" Style="{StaticResource Ws.Value}" />
                                    <TextBlock Text="Bar width" Style="{StaticResource Ws.Label}" />
                                </DockPanel>
                                <Slider Minimum="{Binding MinBarWidthFraction}" Maximum="{Binding MaxBarWidthFraction}"
                                        Value="{Binding BarWidthFraction}" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                        AutomationProperties.Name="Bar width" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Placement" Style="{StaticResource Ws.SectionTitle}" />
                    <Border Style="{StaticResource Ws.CardPanel}">
                        <StackPanel>
                            <Border Style="{StaticResource Ws.SegmentGroup}" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Ws.Segment}" GroupName="Position"
                                                 Content="Bottom" IsChecked="{Binding PositionBottom}" />
                                    <RadioButton Style="{StaticResource Ws.Segment}" GroupName="Position"
                                                 Content="Cursor" IsChecked="{Binding PositionNearCaret}" />
                                    <RadioButton Style="{StaticResource Ws.Segment}" GroupName="Position"
                                                 Content="Top" IsChecked="{Binding PositionTop}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Ws.Caption}"
                                       Text="Following the cursor sits the bar just under the line you are writing, and falls back to the bottom of the screen in apps that do not report a cursor position." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Motion" Style="{StaticResource Ws.SectionTitle}" />
                    <Border Style="{StaticResource Ws.CardPanel}">
                        <StackPanel>
                            <Border Style="{StaticResource Ws.SegmentGroup}" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Ws.Segment}" GroupName="Motion"
                                                 Content="Smooth" IsChecked="{Binding MotionSmooth}" />
                                    <RadioButton Style="{StaticResource Ws.Segment}" GroupName="Motion"
                                                 Content="Balanced" IsChecked="{Binding MotionBalanced}" />
                                    <RadioButton Style="{StaticResource Ws.Segment}" GroupName="Motion"
                                                 Content="Snappy" IsChecked="{Binding MotionSnappy}" />
                                    <RadioButton Style="{StaticResource Ws.Segment}" GroupName="Motion"
                                                 Content="Off" IsChecked="{Binding MotionOff}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding MotionSpeedLabel}" Style="{StaticResource Ws.Caption}" />

                            <Border Style="{StaticResource Ws.Notice}" Margin="0,14,0,0"
                                    Visibility="{Binding MotionDisabledBySystem, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Ws.Caption}" Foreground="{DynamicResource Ws.Warning}"
                                           Text="Windows has animation effects switched off, so the bar moves instantly whatever is chosen here." />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- === Suggestions ====================================================================== -->
            <ScrollViewer x:Name="PageSuggestions" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,24,28,36" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Suggestions" Style="{StaticResource Ws.PageTitle}" />
                    <TextBlock Style="{StaticResource Ws.PageSubtitle}"
                               Text="What the bar offers, and which keys take it." />

                    <TextBlock Text="Words shown" Style="{StaticResource Ws.SectionTitle}" />
                    <Border Style="{StaticResource Ws.CardPanel}">
                        <StackPanel>
                            <ListBox Style="{StaticResource Ws.SegmentedList}"
                                     ItemsSource="{Binding SuggestionCountOptions}"
                                     SelectedItem="{Binding SuggestionCount}"
                                     Margin="0,0,0,8"
                                     AutomationProperties.Name="Words shown on the bar" />
                            <TextBlock Style="{StaticResource Ws.Caption}"
                                       Text="How many columns the bar is divided into. A narrow bar may fit fewer than you ask for; a word too long for its column is shortened in the middle so the columns stay put." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="While you type" Style="{StaticResource Ws.SectionTitle}" />
                    <Border Style="{StaticResource Ws.CardPanel}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding CompleteOnSpace}"
                                          AutomationProperties.Name="Finish a word with Space" />
                                <TextBlock Text="Finish a word with Space" Style="{StaticResource Ws.Label}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Ws.Caption}" Margin="0,0,0,18"
                                       Text="Type &quot;looki&quot; and Space gives &quot;looking &quot;, but only when one completion is clearly the answer. The first word sits in a highlight when Space will take it." />

                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding FixCapitalsAndApostrophes}"
                                          AutomationProperties.Name="Fix capitals and apostrophes" />
                                <TextBlock Text="Fix capitals and apostrophes" Style="{StaticResource Ws.Label}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Ws.Caption}" Margin="0,0,0,18"
                                       Text="im becomes I'm, dont becomes don't, london becomes London, and sentences start with a capital. Words with two real spellings, like ill and were, are left as you typed them." />

                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding AutocorrectEnabled}"
                                          AutomationProperties.Name="Autocorrect misspelled words" />
                                <TextBlock Text="Autocorrect misspelled words" Style="{StaticResource Ws.Label}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Ws.Caption}"
                                       Text="Fixes a finished word against the dictionary. Separate from capitals and apostrophes above." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Between words" Style="{StaticResource Ws.SectionTitle}" />
                    <Border Style="{StaticResource Ws.CardPanel}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding PersistentBar}"
                                          AutomationProperties.Name="Keep suggestions between words" />
                                <TextBlock Text="Keep suggestions between words" Style="{StaticResource Ws.Label}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Ws.Caption}" Margin="0,0,0,18"
                                       Text="Shows what is likely to come next, like a phone keyboard. Tab puts the first one in; Tab again straight away moves to the next." />

                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding PhraseSuggestionsEnabled}"
                                          AutomationProperties.Name="Suggest whole phrases" />
                                <TextBlock Text="Suggest whole phrases" Style="{StaticResource Ws.Label}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Ws.Caption}" Margin="0,0,0,18"
                                       Text="Offers several words as one suggestion — &quot;forward to&quot; rather than just &quot;forward&quot; — when the phrasing is well evidenced." />

                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding EmojiSuggestionsEnabled}"
                                          AutomationProperties.Name="Suggest emoji" />
                                <TextBlock Text="Suggest emoji" Style="{StaticResource Ws.Label}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Ws.Caption}"
                                       Text="Type &quot;pizza&quot; and 🍕 is offered at the end of the bar. One at a time, and only when the match is unambiguous." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Keys" Style="{StaticResource Ws.SectionTitle}" />
                    <Border Style="{StaticResource Ws.CardPanel}">
                        <StackPanel x:Name="ShortcutList" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- === Your words ======================================================================= -->
            <ScrollViewer x:Name="PageWords" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,24,28,36" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Your words" Style="{StaticResource Ws.PageTitle}" />
                    <TextBlock Style="{StaticResource Ws.PageSubtitle}"
                               Text="Names, products, jargon — anything the built-in dictionary does not know. Added words are suggested as you type and are never autocorrected into something else." />

                    <Border Style="{StaticResource Ws.CardPanel}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Button DockPanel.Dock="Right" Content="Add" Margin="8,0,0,0" MinWidth="72"
                                        Style="{StaticResource Ws.AccentButton}"
                                        Click="OnAddPersonalWordClick" IsEnabled="{Binding CanAddPersonalWord}" />
                                <TextBox x:Name="NewWordBox"
                                         Text="{Binding NewPersonalWord, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OnNewWordKeyDown"
                                         AutomationProperties.Name="Add a personal word" />
                            </DockPanel>

                            <Border BorderThickness="1" BorderBrush="{DynamicResource Ws.Card.Border}" CornerRadius="8"
                                    MinHeight="90" MaxHeight="260">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding PersonalWords}" Margin="6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="4,3">
                                                    <Button DockPanel.Dock="Right" Content="Remove" MinHeight="26" Padding="10,0" FontSize="12"
                                                            Click="OnRemovePersonalWordClick" Tag="{Binding}" />
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Ws.Label}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <DockPanel Margin="0,14,0,0">
                                <TextBlock Text="{Binding PersonalWordCountLabel}" Style="{StaticResource Ws.Caption}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Import…" Margin="0,0,8,0" Click="OnImportWordsClick" />
                                    <Button Content="Export…" Click="OnExportWordsClick" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- === Learning and privacy ============================================================= -->
            <ScrollViewer x:Name="PageLearning" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,24,28,36" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Learning &amp; privacy" Style="{StaticResource Ws.PageTitle}" />
                    <TextBlock Style="{StaticResource Ws.PageSubtitle}"
                               Text="Everything WordStrip knows about your writing stays on this computer. There is no account, no telemetry and no upload." />

                    <Border Style="{StaticResource Ws.CardPanel}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding PersonalLearningEnabled}"
                                          AutomationProperties.Name="Learn from what I type" />
                                <TextBlock Text="Learn from what I type" Style="{StaticResource Ws.Label}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Ws.Caption}" Margin="0,0,0,16"
                                       Text="Off by default. When on, WordStrip counts which words you use and which tend to follow each other. It stores counts only — never sentences, documents or keystrokes — and never learns from password fields." />

                            <Border Style="{StaticResource Ws.InfoPanel}">
                                <StackPanel>
                                    <TextBlock Text="{Binding LearnedDataLabel}" Style="{StaticResource Ws.Caption}" Margin="0" />
                                    <TextBlock Style="{StaticResource Ws.Caption}"
                                               Text="Stored locally, on this computer only." />
                                </StackPanel>
                            </Border>

                            <Button Content="Clear everything WordStrip has learned" Margin="0,14,0,0"
                                    HorizontalAlignment="Left" Click="OnClearLearnedDataClick" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- === Context model ===================================================================== -->
            <ScrollViewer x:Name="PageModel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,24,28,36" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Context model" Style="{StaticResource Ws.PageTitle}" />
                    <TextBlock Style="{StaticResource Ws.PageSubtitle}"
                               Text="Optional. A small language model can reorder the suggestions WordStrip has already chosen, using the words before your cursor. It never adds words of its own, and it runs on this computer." />

                    <Border Style="{StaticResource Ws.CardPanel}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding NeuralRerankingEnabled}"
                                          AutomationProperties.Name="Use the model to reorder suggestions" />
                                <TextBlock Text="Use the model to reorder suggestions" Style="{StaticResource Ws.Label}" />
                            </DockPanel>
                            <TextBlock Text="{Binding NeuralStatus}" Style="{StaticResource Ws.Caption}" Margin="0,0,0,14" />

                            <!-- OneWay stated explicitly. ProgressBar.Value binds two-way by default, which
                                 throws on a read-only source property and takes the window down as it opens. -->
                            <ProgressBar Margin="0,0,0,12" Minimum="0" Maximum="1"
                                         Value="{Binding NeuralProgress, Mode=OneWay}"
                                         Visibility="{Binding NeuralBusy, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Button Content="Download" Margin="0,0,8,0" MinWidth="110"
                                        Style="{StaticResource Ws.AccentButton}"
                                        IsEnabled="{Binding CanDownloadNeuralModel}" Click="OnDownloadModelClick" />
                                <Button Content="Delete" MinWidth="96"
                                        IsEnabled="{Binding CanDeleteNeuralModel}" Click="OnDeleteModelClick" />
                            </StackPanel>

                            <Expander Header="Details" Foreground="{DynamicResource Ws.Text.Muted}" FontSize="12.5">
                                <TextBlock Text="{Binding NeuralModelDetails}" Style="{StaticResource Ws.Caption}" Margin="0,8,0,0" />
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- === Integrations ====================================================================== -->
            <ScrollViewer x:Name="PageIntegrations" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,24,28,36" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Integrations" Style="{StaticResource Ws.PageTitle}" />
                    <TextBlock Style="{StaticResource Ws.PageSubtitle}"
                               Text="Notepad and classic Windows text boxes always work. Chrome, Edge, Brave, Electron apps and Word are reached through a small Windows text-service component." />

                    <TextBlock Text="Browser and Office support" Style="{StaticResource Ws.SectionTitle}" />
                    <Border Style="{StaticResource Ws.CardPanel}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <Button Content="Enable" Margin="0,0,8,0" MinWidth="90"
                                            Style="{StaticResource Ws.AccentButton}"
                                            IsEnabled="{Binding CanRegisterTip}" Click="OnEnableTipClick" />
                                    <Button Content="Disable" MinWidth="90"
                                            IsEnabled="{Binding CanUnregisterTip}" Click="OnDisableTipClick" />
                                </StackPanel>
                                <StackPanel>
                                    <!-- Mode=OneWay on both: Run.Text binds two-way by default, which throws
                                         on a read-only source and takes the window down as it opens. -->
                                    <TextBlock Text="{Binding TipRegisteredLabel, Mode=OneWay}" Style="{StaticResource Ws.Label}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TipStatus, Mode=OneWay}" Style="{StaticResource Ws.Caption}" />
                                </StackPanel>
                            </DockPanel>

                            <Border Style="{StaticResource Ws.Notice}" Margin="0,0,0,0"
                                    Visibility="{Binding TipNotSelected, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <Button Content="Switch it on" Margin="12,0,0,0" DockPanel.Dock="Right"
                                            VerticalAlignment="Center" Click="OnSwitchTipOnClick" />
                                    <TextBlock Style="{StaticResource Ws.Caption}" Foreground="{DynamicResource Ws.Warning}"
                                               Text="Installed, but WordStrip is not one of your keyboards, so Windows is not loading it and browsers get no suggestions. Switching it on adds it to your keyboards; the others stay available with Win+Space." />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Ws.InfoPanel}"
                                    Visibility="{Binding TipDllMissing, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Ws.Caption}"
                                           Text="This build does not include the component (WordStripTip.dll is missing from the install folder), so this option is unavailable here." />
                            </Border>

                            <TextBlock Style="{StaticResource Ws.Caption}" Margin="0,12,0,0"
                                       Text="Suggestions only, for now: autocorrect and personal learning stay on the Notepad-style path until a later update." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- === General =========================================================================== -->
            <ScrollViewer x:Name="PageGeneral" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,24,28,36" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="General" Style="{StaticResource Ws.PageTitle}" />
                    <TextBlock Style="{StaticResource Ws.PageSubtitle}"
                               Text="WordStrip runs from the system tray. Everything it does happens on this computer." />

                    <Border Style="{StaticResource Ws.CardPanel}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding StartWithWindows}"
                                          AutomationProperties.Name="Start WordStrip when Windows starts" />
                                <TextBlock Text="Start WordStrip when Windows starts" Style="{StaticResource Ws.Label}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Ws.Caption}"
                                       Text="Suggestions are always switched off in password fields, whatever is set here." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
