<Window x:Class="WordStrip.App.UI.SuggestionBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WordStrip.App.UI"
        Title="WordStrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid x:Name="RootHost"
          Opacity="0"
          RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="RootTranslate" Y="12" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- The plate is a separate, static layer from the chips on purpose. A DropShadowEffect forces its
             whole subtree through an offscreen pass every time anything inside it changes, so with the
             selection lens living under the same effect the shadow shader re-ran on every animation frame.
             Keeping the shadow on a sibling that never changes during animation is the single biggest
             smoothness win here. -->
        <ui:GlassPlate x:Name="Plate" />

        <!-- The lens spans the whole bar rather than the padded content area, because the position
             indicator it draws sits below the chips. It paints behind them either way. -->
        <ui:SelectionLens x:Name="Lens" Opacity="0" />

        <Grid x:Name="ContentLayer">
            <ItemsControl x:Name="ChipList" ItemsSource="{Binding Chips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type ui:SuggestionChipViewModel}">
                        <Button Click="OnChipClick"
                                Cursor="Hand"
                                Focusable="False"
                                BorderThickness="0"
                                Background="Transparent"
                                Padding="{Binding Padding}"
                                MinHeight="{Binding MinHeight}"
                                Margin="{Binding Margin}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <!-- Hover is an overlay whose opacity animates, rather than an
                                             animated colour, so its tint can come from the active theme
                                             instead of being baked into the template. -->
                                        <Border x:Name="HoverLayer"
                                                CornerRadius="{Binding CornerRadius}"
                                                Background="{Binding HoverBrush}"
                                                Opacity="0" />
                                        <Border Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <!-- Hover registers, it doesn't perform. -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:0.10" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.16" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>

                            <TextBlock Text="{Binding Word}"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="{Binding FontSize}"
                                       FontWeight="{Binding FontWeight}"
                                       Foreground="{Binding Foreground}" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
